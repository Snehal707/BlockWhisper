# Base & OnchainKit
NEXT_PUBLIC_ONCHAINKIT_API_KEY=your_coinbase_onchainkit_api_key_here
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=your_walletconnect_project_id_here

# Basescan
BASESCAN_API_KEY=your_basescan_api_key_here

# Nous Research / LLM
NOUS_API_KEY=your_nous_research_api_key_here
NOUS_API_URL=https://inference-api.nousresearch.com/v1/chat/completions

# Paymaster
NEXT_PUBLIC_PAYMASTER_URL=your_paymaster_url_here

# Deployment (for Hardhat) - Add your wallet's private key here
# Get it from MetaMask: Settings > Security & Privacy > Show private key
# IMPORTANT: Never commit this file to git!
PRIVATE_KEY=your_private_key_without_0x_prefix

# Contract Address (updated after deployment)
NEXT_PUBLIC_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Alchemy API keys
ALCHEMY_API_KEY=your_alchemy_api_key_here
